@page "/kontakt-os"

@rendermode InteractiveServer

<h3>Kontaktformular</h3>

<EditForm Model="@contactForm" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div>
        <label>Navn:</label>
        <InputText @bind-Value="contactForm.Name" class="form-control" />
        <ValidationMessage For="@(() => contactForm.Name)" />
    </div>
    <div>
        <label>E-mail:</label>
        <InputText @bind-Value="contactForm.Email" class="form-control" />
        <ValidationMessage For="@(() => contactForm.Email)" />
    </div>
    <div>
        <label>Besked:</label>
        <InputTextArea @bind-Value="contactForm.Message" class="form-control" />
        <ValidationMessage For="@(() => contactForm.Message)" />
    </div>
    <button type="submit" class="btn btn-primary">Send</button>
</EditForm>

<h4>Indsendte beskeder</h4>
<ul>
    @foreach (var submission in submissions)
    {
        <li>
            <strong>@submission.Name:</strong> @submission.Message (Email: @submission.Email)
        </li>
    }
</ul>



@code {
    private ContactForm contactForm = new ContactForm();
    private List<ContactForm> submissions = new List<ContactForm>();

    private void HandleValidSubmit()
    {
        submissions.Add(new ContactForm
            {
                Name = contactForm.Name,
                Email = contactForm.Email,
                Message = contactForm.Message
            });
        contactForm = new ContactForm();
    }
}
